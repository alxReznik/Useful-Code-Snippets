
const Environments = Object.freeze({
    "https://melave-mo-dev.crm4.dynamics.com": "melave-mo-dev",
    "https://melave-m0-test.crm4.dynamics.com": "melave-m0-test",
    "https://melave.crm4.dynamics.com": "melave",
    "https://melave-edu.crm4.dynamics.com": "melave-edu"
});

function getCurrentEnvironmentName() {
    const currentUrl = Xrm.Utility
        .getGlobalContext()
        .getClientUrl()
        .replace(/\/$/, "");

    return Environments[currentUrl] || "Unknown Environment";
}

async function getUsersByRoleIds() {
    const environmentName = getCurrentEnvironmentName();

    const fetchXml = `
<fetch version="1.0" mapping="logical" distinct="true">
  <entity name="systemuser">
    <attribute name="systemuserid" />
    <attribute name="fullname" />
    <attribute name="domainname" />
    <attribute name="isdisabled" />
    <link-entity name="systemuserroles"
      from="systemuserid"
      to="systemuserid"
      intersect="true">
      <filter type="or">
        <condition attribute="roleid" operator="eq"
          value="06ffdf9f-bd59-f111-bec7-002248a159c5" />
        <condition attribute="roleid" operator="eq"
          value="4d7c4b6d-5af4-ef11-be1f-7c1e5236ecd1" />
        <condition attribute="roleid" operator="eq"
          value="c30bdbfe-7553-e811-8147-000d3aa39708" />
      </filter>
    </link-entity>
  </entity>
</fetch>`.trim();

    try {
        const response = await Xrm.WebApi.retrieveMultipleRecords(
            "systemuser",
            `?fetchXml=${encodeURIComponent(fetchXml)}`
        );

        if (!response.entities || response.entities.length === 0) {
            console.warn("No users found with the specified security roles.");
            return;
        }

        const tableData = response.entities.map((user, index) => ({
            "Index": index + 1,
            "Environment Name": environmentName,
            "Full Name": user.fullname || "",
            "Domain": user.domainname || "",
            "Status": user.isdisabled ? "Disabled" : "Enabled"
        }));
console.log(`Environment: ${environmentName}`);
        console.table(tableData);
        
        console.log(`Total users found: ${tableData.length}`);

        return tableData;

    } catch (error) {
        console.error("Error retrieving users:", error.message || error);
    }
}

getUsersByRoleIds();
